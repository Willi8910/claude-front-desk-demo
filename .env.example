# All variables are optional. No keys are needed for a working demo.
# Leave blank for seeded, per-process memory storage.
DATABASE_URL=
# Used for default Stripe redirect URLs (never inferred from request headers).
APP_URL=http://localhost:3000
# Checkout uses mock mode without this key. Use Stripe test keys for demos.
STRIPE_SECRET_KEY=
# Live webhook verification requires BOTH Stripe variables.
STRIPE_WEBHOOK_SECRET=
# Email uses Resend; missing either value enables console mock mode.
RESEND_API_KEY=
EMAIL_FROM=
# SMS uses Twilio; missing any value enables console mock mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
